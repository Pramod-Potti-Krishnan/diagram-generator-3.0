{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "journey_schema.json",
  "title": "Journey Chart Schema",
  "description": "Schema for Plotly user journey chart data extraction",
  "type": "object",
  "required": ["stages"],
  "properties": {
    "title": {
      "type": "string",
      "description": "Journey title",
      "maxLength": 100
    },
    "persona": {
      "type": "string",
      "description": "User persona name",
      "maxLength": 50
    },
    "stages": {
      "type": "array",
      "description": "Journey stages",
      "minItems": 2,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["name", "steps"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Stage name",
            "maxLength": 30
          },
          "steps": {
            "type": "array",
            "description": "Steps within this stage",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "type": "object",
              "required": ["action", "sentiment", "score"],
              "properties": {
                "action": {
                  "type": "string",
                  "description": "User action description",
                  "maxLength": 40
                },
                "sentiment": {
                  "type": "string",
                  "description": "User sentiment",
                  "enum": ["positive", "neutral", "negative"]
                },
                "score": {
                  "type": "integer",
                  "description": "Satisfaction score 1-5",
                  "minimum": 1,
                  "maximum": 5
                }
              }
            }
          }
        }
      }
    },
    "theme": {
      "type": "object",
      "properties": {
        "primary_color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "default": "#8B5CF6"
        }
      }
    }
  },
  "examples": [
    {
      "title": "User Onboarding Journey",
      "persona": "New User",
      "stages": [
        {
          "name": "Discovery",
          "steps": [
            {"action": "See advertisement", "sentiment": "positive", "score": 4},
            {"action": "Visit website", "sentiment": "neutral", "score": 3}
          ]
        },
        {
          "name": "Trial",
          "steps": [
            {"action": "Sign up", "sentiment": "positive", "score": 5},
            {"action": "Configure settings", "sentiment": "negative", "score": 2}
          ]
        },
        {
          "name": "Adoption",
          "steps": [
            {"action": "Complete first project", "sentiment": "positive", "score": 5}
          ]
        }
      ]
    }
  ]
}
