{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "kanban_schema.json",
  "title": "Kanban Board Schema",
  "description": "Schema for custom HTML/Tailwind Kanban board data extraction",
  "type": "object",
  "required": ["columns"],
  "properties": {
    "title": {
      "type": "string",
      "description": "Board title",
      "maxLength": 100
    },
    "columns": {
      "type": "array",
      "description": "Kanban columns",
      "minItems": 2,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["name", "items"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Column header",
            "maxLength": 30
          },
          "color": {
            "type": "string",
            "description": "Column background color",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "items": {
            "type": "array",
            "description": "Cards in this column",
            "maxItems": 10,
            "items": {
              "type": "object",
              "required": ["title"],
              "properties": {
                "title": {
                  "type": "string",
                  "description": "Card title",
                  "maxLength": 50
                },
                "priority": {
                  "type": "string",
                  "description": "Task priority",
                  "enum": ["high", "medium", "low", ""]
                },
                "assignee": {
                  "type": "string",
                  "description": "Assignee initials or name",
                  "maxLength": 10
                }
              }
            }
          }
        }
      }
    },
    "theme": {
      "type": "object",
      "properties": {
        "primary_color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "default": "#8B5CF6"
        },
        "background_color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "default": "#FFFFFF"
        },
        "text_color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "default": "#1F2937"
        }
      }
    }
  },
  "examples": [
    {
      "title": "Sprint 14 Board",
      "columns": [
        {
          "name": "Backlog",
          "color": "#F3F4F6",
          "items": [
            {"title": "User authentication", "priority": "high", "assignee": "JD"},
            {"title": "Payment integration", "priority": "medium", "assignee": "SM"},
            {"title": "Email notifications", "priority": "low", "assignee": ""}
          ]
        },
        {
          "name": "In Progress",
          "color": "#DBEAFE",
          "items": [
            {"title": "Dashboard redesign", "priority": "high", "assignee": "AK"},
            {"title": "API documentation", "priority": "medium", "assignee": "JD"}
          ]
        },
        {
          "name": "Review",
          "color": "#FEF3C7",
          "items": [
            {"title": "Database optimization", "priority": "high", "assignee": "SM"}
          ]
        },
        {
          "name": "Done",
          "color": "#D1FAE5",
          "items": [
            {"title": "Login page", "priority": "medium", "assignee": "AK"},
            {"title": "CI/CD setup", "priority": "high", "assignee": "JD"},
            {"title": "Unit tests", "priority": "low", "assignee": "SM"}
          ]
        }
      ]
    }
  ]
}
